# The app and Socket.io service must use the same database and secret.
DATABASE_URL=postgresql://user:password@localhost:5432/collab_editor
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_PORT=3001

# Optional social sign-in: each provider needs both values.
# Setup and exact callbacks: docs/social-sign-in.md
# These are server-only credentials; never use NEXT_PUBLIC_ prefixes.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
# Apple additionally requires NEXTAUTH_URL to be a registered HTTPS domain.
# APPLE_ID is the Services ID; APPLE_SECRET is a signed, expiring JWT (not a .p8 key).
APPLE_ID=
APPLE_SECRET=
